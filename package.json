{
	"name": "sorzs-e2e",
	"private": true,
	"type": "module",
	"scripts": {
		"e2e": "docker compose -f compose.yaml -f compose.sample-site.yaml up --build --abort-on-container-exit --exit-code-from e2e",
		"up": "docker compose up --build --wait --detach backend frontend",
		"down": "docker compose -f compose.yaml -f compose.sample-site.yaml down",
		"lint": "biome check . && npm run lint:language",
		"lint:language": "grep -rIiP '(?<!re)source' tests --exclude-from=language-exceptions.txt; test $? -eq 1",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
